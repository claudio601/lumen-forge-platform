{
  "regions": [
    "iad1"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/spa.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "nuevo.elights.cl"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
